{
  "name": "pi-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A multi-agent line factory on top of pi: spec layer, line runtime, balancing, and a canvas dashboard in Electron.",
  "main": "app/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "server": "node --env-file-if-exists=.env server/main.ts",
    "app": "electron .",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "pi:install": "node scripts/install-pi.mjs",
    "check:canvas": "node scripts/check-canvas.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "dompurify": "^3.4.16",
    "lit": "^3.3.3",
    "lucide-react": "^1.54.0",
    "marked": "^16.4.2",
    "playwright-core": "^1.64.0",
    "typebox": "^1.3.36",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rolldown": "^1.2.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
